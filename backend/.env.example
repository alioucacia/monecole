SECRET_KEY=dev-secret-key-change-in-production
DEBUG=false
DJANGO_ALLOWED_HOSTS=*
# PostgreSQL (voir docker-compose.yml pour lancer une instance locale avec `docker compose up -d db`).
# Obligatoire — le backend n'utilise plus SQLite et refuse de démarrer sans cette variable.
DATABASE_URL=postgres://ecole_user:ecole_password@localhost:5432/ecole_db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache Django + backend du throttling DRF (voir DEPLOYMENT.md). Sans cette variable, le
# backend retombe sur un cache mémoire local (pratique en dev, mais pas partagé entre
# plusieurs workers/réplicas — à définir dès qu'on en fait tourner plus d'un).
# REDIS_URL=redis://localhost:6379/0

# Quotas de requêtes par minute (protège la DB partagée d'un pic/abus) — défauts déjà
# appliqués sans définir ces variables, à resserrer seulement si un abus réel est observé.
# THROTTLE_RATE_ANON=100/minute
# THROTTLE_RATE_USER=1000/minute

# URL du frontend, utilisée pour construire le lien de réinitialisation de mot de passe
# et le lien de vérification des badges (QR code).
FRONTEND_URL=http://localhost:5173

# URL publique du backend (doit être joignable directement), utilisée pour le lien de
# téléchargement du bulletin envoyé par SMS.
BACKEND_PUBLIC_URL=http://localhost:8000

# E-mail : par défaut les messages sont juste affichés dans la console du serveur (dev).
# Pour un envoi réel, passer à smtp et renseigner les identifiants de votre fournisseur.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ecole-manager.local

# SMS : par défaut simulés (journalisés dans la console). Pour un envoi réel, choisir UN
# fournisseur ci-dessous avec SMS_PROVIDER, puis renseigner uniquement ses identifiants —
# changer de fournisseur plus tard ne demande de modifier que cette ligne.
# SMS_PROVIDER=nimbasms
# Indicatif international préfixé aux numéros locaux (saisis sans indicatif dans ce projet,
# ex: "624086668") avant l'envoi, quel que soit le fournisseur. Guinée par défaut.
SMS_INDICATIF_DEFAUT=+224

# NimbaSMS (nimbasms.com) — SID + jeton secret depuis le tableau de bord NimbaSMS.
NIMBASMS_SID=
NIMBASMS_SECRET_TOKEN=
NIMBASMS_SENDER_NAME=Taly School

# Infobip (infobip.com) — clé API ET URL de base, toutes deux personnelles à votre compte
# (visibles sur la page d'accueil du portail Infobip ; l'URL de base a la forme
# "xxxxxxx.api.infobip.com", propre à chaque compte). INFOBIP_SENDER est votre identifiant
# expéditeur (Sender ID alphanumérique enregistré) ou un numéro dédié selon votre compte/pays.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=Taly School

# Twilio (console.twilio.com) — fournisseur historique, conservé disponible.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio expéditeur, au format E.164 (ex: +15017122661).
TWILIO_FROM_NUMBER=
TWILIO_INDICATIF_DEFAUT=+224

# WhatsApp (même compte Twilio ci-dessus) : par défaut aussi simulé (journalisé en console).
# Pour un envoi réel, renseigner un numéro WhatsApp-activé — en test, le numéro du "WhatsApp
# Sandbox" de Twilio (console.twilio.com > Messaging > Try it out > Send a WhatsApp message) ;
# en production, un numéro validé auprès de Meta via Twilio (WhatsApp Business API).
TWILIO_WHATSAPP_FROM_NUMBER=
